---
// Top bar on every page: name and role on the left, tabs and icon links on the right.
// To add a tab, add an entry to `tabs` in src/site.config.ts.
// The icon links (GitHub, LinkedIn, email, resume) come from `site` in the same file.
import { site, tabs } from '../site.config';

const path = Astro.url.pathname;
// A tab is active on its own page and on every page under it.
// Portfolio ("/") also owns the project pages under /projects/.
const isActive = (href: string, match?: string[]) =>
  href === '/' ? path === '/' || (match ?? []).some((m) => path.startsWith(m)) : path.startsWith(href);

// Outline icons from Lucide (lucide.dev, ISC license).
const icons = [
  {
    label: 'GitHub',
    href: site.github,
    svg: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  },
  {
    label: 'LinkedIn',
    href: site.linkedin,
    svg: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  },
  {
    label: `Email ${site.email}`,
    href: `mailto:${site.email}`,
    svg: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  },
  {
    label: 'Resume (PDF)',
    href: site.resume,
    svg: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
  },
].filter((i) => i.href);
---

<header class="site-header">
  <div class="wrap bar">
    <div class="brand-wrap">
      <a class="brand" href="/">{site.shortName}</a>
      <span class="brand-role">{site.role}</span>
    </div>
    <div class="bar-right">
      <nav aria-label="Main">
        {
          tabs.map((t) => (
            <a href={t.href} class:list={['tab', { active: isActive(t.href, t.match) }]} aria-current={isActive(t.href, t.match) ? 'page' : undefined}>
              {t.label}
            </a>
          ))
        }
      </nav>
      <div class="icon-links">
        {
          icons.map((i) => (
            <a class="icon-link" href={i.href} target={i.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener" aria-label={i.label} title={i.label}>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={i.svg} />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</header>
