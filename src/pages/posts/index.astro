---
// Posts tab: every published post, newest first.
import Layout from '../../layouts/Layout.astro';
import { getPosts, formatDate, isoDate } from '../../lib/posts';

const posts = await getPosts();
---

<Layout title="Posts" description="Notes and write-ups by Matt Si.">
  <header class="page-head">
    <span class="label">Writing</span>
    <h1>Posts</h1>
    <p class="lede">Notes on what I build and what I learn along the way. <a href="/rss.xml">RSS feed</a></p>
  </header>

  <section>
    {
      posts.length === 0 ? (
        <div class="empty">
          <p>No posts yet. The first one is on its way.</p>
        </div>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post-item">
              <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
              <div>
                <h2>
                  <a href={`/posts/${post.id}/`}>{post.data.title}</a>
                  {post.data.draft && <span class="draft-badge">draft</span>}
                </h2>
                <p>{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <ul class="tags">
                    {post.data.tags.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>
